# Sunvision configuration. Copy to `.env` (gitignored) and fill in what you need.
# Nothing here is required for the curated examples: they ship with recorded inference.

# --- Computer vision API (api/) -------------------------------------------------
# Shared Roboflow API key (private). Enables hosted RF-DETR facade inference for
# visitors who have not added their own key, and re-recording fixtures. It is never
# sent to the browser. NEVER expose it in frontend code. Visitors can bring their own
# key instead: the web app sends it per request in the `X-Roboflow-Key` header, and
# the API uses it for that request only (never logged or stored).
ROBOFLOW_API_KEY=
# Monthly cap on analyses that use the shared key (UTC calendar month).
# 0 disables the shared key entirely (bring-your-own-key only deployment).
SUNVISION_SHARED_MONTHLY_IMAGE_CAP=2000
# Shared-key analyses per client per UTC day (client = salted hash of the IP). 0 = no per-client limit.
SUNVISION_SHARED_DAILY_PER_CLIENT=5
# Quota ledger (gitignored). Relative paths are resolved from the repository root.
SUNVISION_QUOTA_FILE=api/.quota/roboflow.json
# Optional fixed salt for client-IP hashing (recommended for deploys). Otherwise a random salt is kept
# in a separate 0600 sidecar file (<ledger>.salt), never in the ledger, and rotated every UTC day.
# SUNVISION_QUOTA_SALT=
# Set to 1 only when the API runs behind exactly one reverse proxy that appends X-Forwarded-For.
# SUNVISION_TRUST_PROXY=0
# Facade model (Roboflow Universe, CC BY 4.0). Override to try another version.
SUNVISION_FACADE_MODEL=building-facade-segmentation-instance/4
# Hosted inference endpoint (or a self-hosted Roboflow Inference server, e.g. http://localhost:9001)
ROBOFLOW_API_URL=https://serverless.roboflow.com
# Depth model for local depth estimation (transformers). Apache-2.0.
SUNVISION_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
# Depth backend: 'transformers' (default, local) or 'inference-models' (Roboflow Depth Anything 3, needs a key).
# SUNVISION_DEPTH_PROVIDER=transformers
# Allowed browser origins for the API (comma-separated). Replaces the default
# http://localhost:5173,http://127.0.0.1:5173 — include those if you still need them.
# SUNVISION_CORS_ORIGINS=
# Hugging Face cache location (optional)
# HF_HOME=

# --- Web app (web/) — public, build-time values only (no secrets!) -------------
# Vite reads this root .env (envDir: '..'); only VITE_* variables reach the browser bundle.
# Overpass API endpoint used by the upload flow (mirrors are tried automatically).
VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Geocoder (Nominatim-compatible). Respect the usage policy of public instances.
VITE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# Photon geocoder (tried before Nominatim).
VITE_PHOTON_URL=https://photon.komoot.io/api
# Optional repository link shown on the landing page.
# VITE_REPO_URL=
